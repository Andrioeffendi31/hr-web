# Local dev Postgres (docker). Swap for your Neon pooled connection string in
# staging/production — same driver, no code change.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/hrapp?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) — Berkas uploads, employee photos, clock-in selfies.
# Token: R2 dashboard > Manage API Tokens > Object Read & Write, scoped to this bucket.
# Keep the bucket private; files are served through /api/files, never directly.
# Leave these empty and the upload routes answer 503 instead of failing at boot.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hrapp
# Dev only: point the S3 calls at a local stand-in instead of R2, e.g.
# podman run -d --name localstack -p 4566:4566 localstack/localstack
# R2_ENDPOINT=http://localhost:4566

# Outbound email lewat SMTP (notifikasi pengajuan + tautan "lupa kata sandi").
#
# Kosongkan semuanya dan setiap kiriman hanya tercetak ke stdout, termasuk tautan
# resetnya, jadi dev lokal jalan tanpa kredensial.
#
# Gmail: aktifkan 2FA lalu buat App Password di
# https://myaccount.google.com/apppasswords — SMTP_PASS bukan kata sandi biasa, dan
# EMAIL_FROM harus sama dengan SMTP_USER. Batas ~500 penerima/hari.
#
# Provider lain (Resend, Brevo) juga bicara SMTP, jadi cukup ganti keempat nilai ini
# tanpa mengubah kode — tapi semuanya mewajibkan domain pengirim terverifikasi.
#
# AUTH_URL harus origin publik yang benar — tautan reset dibangun dari situ.
# Di Vercel boleh dikosongkan: lib/url.ts jatuh ke VERCEL_PROJECT_PRODUCTION_URL,
# jadi lupa mengisinya tidak lagi mengirim tautan localhost ke kotak masuk orang.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
