# Local dev Postgres (docker). Swap for your Neon pooled connection string in
# staging/production — same driver, no code change.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/hrapp?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) — Berkas uploads, employee photos, clock-in selfies.
# Token: R2 dashboard > Manage API Tokens > Object Read & Write, scoped to this bucket.
# Keep the bucket private; files are served through /api/files, never directly.
# Leave these empty and the upload routes answer 503 instead of failing at boot.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hrapp
# Dev only: point the S3 calls at a local stand-in instead of R2, e.g.
# podman run -d --name localstack -p 4566:4566 localstack/localstack
# R2_ENDPOINT=http://localhost:4566
